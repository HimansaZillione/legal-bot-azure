# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://ai-studio-search-basic.search.windows.net
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key
AZURE_SEARCH_INDEX_NAME=hp-test-legaldocs-index

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://aitestnew.openai.azure.com
AZURE_OPENAI_API_KEY=your-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure AI Foundry Project
AZURE_AI_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=aisearchtestnew
AZURE_STORAGE_CONTAINER=hp-test-legaldocs
